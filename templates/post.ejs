<html>
  <head>
    <title><%- data.title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link type="text/css" rel="stylesheet" href="/stylesheet.css">
  </head>

  <body>
    <%- navbar %>
    <div class="c-content-area">
      <div class="c-post-navigation-container">
        <div class="c-post-navigation-primary-container">
          <p><a href="/<%= postListPath %>"><%= postListPath.charAt(0).toUpperCase() + postListPath.slice(1) %></a>&ensp;/&ensp;<%= data.title %></p>
        </div>
        <div class="c-post-navigation-secondary-container">
        </div>
      </div>
      <div class="c-post-metadata">
        <div class="c-card c-post-metadata-general-info">
          <p><b>Author:</b> <%= data.author %></p>
          <p><b>Posted on:</b> <%= parseTimestamp(data.created) %></p>
          <p><b>Last edited on:</b> <%= parseTimestamp(data.modified) %></p>
        </div>
        <div class="c-post-metadata-category">
          <div class="c-content-tags">
            <% data.category.sort().forEach(function(x) { %>
            <div class="c-content-tag"><%= x %></div>
            <% }); %>
          </div>
        </div>
      </div>
      <%- content %>
    </div>
    <%- footer %>
  </body>
</html>
